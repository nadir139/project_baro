# SpeedLead AI - OpenClaw Agent Dockerfile
# Builds OpenClaw from source with custom skills pre-loaded

FROM node:20-slim AS base

RUN apt-get update && apt-get install -y \
    git curl python3 python3-pip \
    chromium \
    --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -s /bin/bash node || true

WORKDIR /app

# Clone and build OpenClaw
RUN git clone --depth 1 https://github.com/openclaw/openclaw.git . && \
    npm ci && \
    npm run build

# Copy custom skills and config
COPY skills/ /home/node/.openclaw/workspace/skills/
COPY config/ /home/node/.openclaw/config/

# Set ownership
RUN chown -R node:node /home/node/.openclaw /app

USER node

ENV NODE_ENV=production
ENV OPENCLAW_HEADLESS=true

EXPOSE 18789

CMD ["node", "dist/gateway.js"]
