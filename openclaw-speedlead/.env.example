# ═══════════════════════════════════════════════════════════
# SpeedLead AI - Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ─── Client Identification ─────────────────────────────────
CLIENT_ID=acme-srl
CLIENT_NAME="Acme S.r.l."
CLIENT_SECTOR=manifattura

# ─── LLM Provider (anthropic | openai | xai | openrouter) ─
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...

# ─── Supabase (EU Region) ─────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ─── WhatsApp (Baileys - default, free) ───────────────────
# No config needed - pair via QR code on first run
# For Cloud API (optional upgrade):
# WHATSAPP_MODE=cloud_api
# WHATSAPP_BUSINESS_ID=...
# WHATSAPP_ACCESS_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...

# ─── Twilio (Voice) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+39...

# ─── Deepgram (STT) ──────────────────────────────────────
DEEPGRAM_API_KEY=...

# ─── Cartesia (TTS) ──────────────────────────────────────
CARTESIA_API_KEY=...
CARTESIA_VOICE_ID=italian-male-professional

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vendite@acme.it
SMTP_PASS=...
IMAP_HOST=imap.gmail.com
IMAP_USER=vendite@acme.it
IMAP_PASS=...

# ─── Calendar ────────────────────────────────────────────
# Cal.com
CALCOM_API_KEY=cal_live_...
CALCOM_EVENT_TYPE_ID=123456
# Or Google Calendar
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_SERVICE_ACCOUNT_KEY=./config/google-sa.json

# ─── CRM Sync (optional) ────────────────────────────────
# HUBSPOT_API_KEY=...
# ZOHO_CLIENT_ID=...
# ZOHO_CLIENT_SECRET=...
# TEAMSYSTEM_API_URL=...
# TEAMSYSTEM_API_KEY=...

# ─── Ports ───────────────────────────────────────────────
OPENCLAW_PORT=18789
VOICE_PORT=8765
WEBHOOK_PORT=8766

# ─── Domain (for Caddy HTTPS) ───────────────────────────
DOMAIN=acme.speedlead.ai
